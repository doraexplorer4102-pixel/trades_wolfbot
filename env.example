# Copy this file to ".env" and fill in your REAL values for local testing.
# The real ".env" is ignored by git and must NEVER be committed or shared.
# On Railway, set these same names in the Variables tab instead.

# ── Required ──────────────────────────────────────────────────────────────
BOT_TOKEN=your-telegram-bot-token-here
DATABASE_URL=postgresql://user:password@host:port/dbname
ADMIN_KEY=a-long-random-string
POSTBACK_KEY=another-long-random-string
OWNER_ID=your-telegram-user-id-here

# ── Core config (working defaults exist in code — override only if needed) ─
# AFFILIATE=https://broker-qx.pro/sign-up/?lid=your-id
# REGISTER_LINK=https://broker-qx.pro/sign-up/?lid=your-id
# TG_CHANNEL=https://t.me/your-public-channel
# VIP_LINK=https://t.me/your-vip-channel
# SUPPORT=https://t.me/your-support-username
# SUPPORT_USER=@your-support-username
# MIN_DEPOSIT=15
# DEPOSIT_VALID_DAYS=10
# YOUTUBE=https://youtube.com/@your-channel
# COURSE_LINK=https://your-free-course-link

# ── Media (all optional — see README.md for the full list of file_id vars) ─
# SEQ1_STICKER=...
# SEQ1_PHOTO=...
# REM1_PHOTO=...
# ...and so on — see README.md "Media" section for the complete list.
